#!/bin/bash
# Pre-commit quality gate. See docs/context/GIT_HOOKS.md
#
# Mirrors the checks in .github/workflows/ci.yml so failures surface locally
# rather than in CI. The oracle harness (the OCaml QCheck identity suite) is
# part of the gate; SKIP_OCAML=1 skips it explicitly, nothing skips it
# silently.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

fail() {
    echo "pre-commit: $1" >&2
    echo "pre-commit: commit aborted. Run ./scripts/fix-code-quality.sh for fmt/clippy fixes." >&2
    exit 1
}

echo "pre-commit: checking formatting..."
cargo fmt --all --check || fail "formatting check failed"

echo "pre-commit: running clippy..."
cargo clippy --all-targets --all-features -- -D warnings || fail "clippy reported warnings"

echo "pre-commit: type checking..."
cargo check --all-targets --all-features || fail "type check failed"

echo "pre-commit: building docs..."
cargo doc --no-deps --all-features || fail "doc build failed (broken intra-doc link?)"

echo "pre-commit: running Rust tests..."
cargo test --all --all-features || fail "Rust tests failed"

if [ "${SKIP_OCAML:-0}" = "1" ]; then
    echo "pre-commit: skipping the oracle harness (SKIP_OCAML=1)"
    echo "pre-commit: all other checks passed."
    exit 0
fi

command -v dune >/dev/null 2>&1 || fail "dune not found; the oracle harness needs opam with dune, qcheck and typeset (or set SKIP_OCAML=1)"

echo "pre-commit: building the oracle harness..."
(cd oracle && ./build.sh >/dev/null 2>&1) || fail "oracle harness failed to build (opam install dune qcheck typeset?)"

echo "pre-commit: running the oracle identity suite..."
(cd oracle && ./_build/tester) || fail "the Rust renderer diverged from the OCaml reference"

echo "pre-commit: all checks passed."
